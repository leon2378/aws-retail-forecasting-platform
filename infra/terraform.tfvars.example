region = "ap-southeast-2"
project = "retail-forecast"
schedule_enabled = false
initial_cutoff = 196
candidate_model = "seasonal"
sagemaker_instance_type = "ml.m5.xlarge"
# After the foundation is applied and the model image is pushed:
# pipeline_definition_file = "../build/pipeline.json"
enable_delivery = false
enable_clearml = false
monitoring_enabled = false
monthly_budget_usd = 10
# Put the recipient only in ignored terraform.tfvars, then review a new plan:
# alert_email = "you@example.com"
# Budget covers all account spend before credits/refunds/discounts. No hard cap.
# Confirm the SNS subscription email after a later approved deployment.
# Cognito sign-in is mandatory for AWS API results and simulations. Users and
# viewer/planner memberships are invited/assigned outside Terraform by an operator.
# The CloudFront root is automatically registered for sign-in and sign-out.
# Explicit optional callback roots for a later Cognito-connected local preview:
# Registration does not switch the app's default CloudFront callback. A preview
# must use matching reviewed callback/sign-out settings in its auth configuration.
# auth_additional_callback_urls = ["http://127.0.0.1:8000/"]
# auth_additional_logout_urls = ["http://127.0.0.1:8000/"]
# clearml_vpc_id = "vpc-..."
# clearml_subnet_id = "subnet-..."
# clearml_ami_id = "ami-..." # reviewed server image; must include SSM Agent
